{
  "name": "ai-102-quiz-app",
  "version": "1.0.0",
  "description": "A local React + TypeScript quiz app for Azure AI-102 certification",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "quiz",
    "react",
    "typescript",
    "vite",
    "azure",
    "ai-102"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "parse-quiz": "node scripts/parseQuestions.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "vitest": "^4.1.5"
  }
}
